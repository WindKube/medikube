package tags

import "strconv"

// Picker is the autocomplete every tag field types against (FR-068): as the
// person types, the candidate list narrows to what matches, each option
// carrying its own usage count so a person can tell "cardiology (12)" from a
// tag nobody has used yet. Narrowing happens client-side, against props.Signal
// — the list is already the whole of what this account has, contracts/tags.md
// §1 caps it at a page, and a second round trip per keystroke would only add
// latency to a comparison the browser can make on its own.
templ Picker(props PickerProps) {
	<div id={ props.ID } class="relative max-w-sm">
		if props.Label != "" {
			<label for={ props.ID + "-input" } class="block text-sm font-medium text-slate-700 dark:text-slate-300">{ props.Label }</label>
		}
		<input
			id={ props.ID + "-input" }
			type="text"
			autocomplete="off"
			role="combobox"
			aria-expanded="true"
			aria-controls={ props.ID + "-options" }
			data-bind={ props.Signal }
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900"
		/>
		<ul id={ props.ID + "-options" } role="listbox" class="mt-2 flex flex-col gap-1">
			for _, option := range props.Options {
				<li
					role="option"
					data-tag-id={ option.ID }
					data-show={ "$" + props.Signal + " === '' || " + jsQuote(lowered(option.Name)) + ".includes($" + props.Signal + ".toLowerCase())" }
					class="flex items-center justify-between gap-3 rounded-md px-2 py-1 text-sm hover:bg-slate-100 dark:hover:bg-slate-800"
				>
					<span class="flex items-center gap-2">
						<span
							aria-hidden="true"
							style={ "background-color:" + option.Color }
							class="inline-block h-2.5 w-2.5 rounded-full"
						></span>
						{ option.Name }
					</span>
					<span class="text-slate-500 dark:text-slate-400">{ strconv.Itoa(option.UsageCount) }</span>
				</li>
			}
		</ul>
	</div>
}

func lowered(value string) string {
	out := []rune(value)
	for i, r := range out {
		if r >= 'A' && r <= 'Z' {
			out[i] = r + ('a' - 'A')
		}
	}
	return string(out)
}

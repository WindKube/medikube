package directory

import (
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

const (
	facilitiesLandmark   = "Facilities"
	facilitiesEmptyTitle = "Nothing recorded yet"
	facilitiesEmptyBody  = "Add the first one and it will be listed here."
	addFacilityLabel     = "Add a facility"
)

// FacilityList is contracts/pages.md P5's landmark.
templ FacilityList(props FacilityListProps) {
	<section
		id={ ids.DirectoryList(FacilitySegment) }
		aria-label={ facilitiesLandmark }
		class="flex flex-col"
	>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.DirectoryListHeading(FacilitySegment) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ facilitiesLandmark }</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ addFacilityLabel }</a>
			}
		</div>
		if len(props.Facilities) == 0 {
			<div class="mt-6">
				@components.EmptyState(components.EmptyStateProps{
					ID:          ids.DirectoryEmpty(FacilitySegment),
					Title:       facilitiesEmptyTitle,
					Body:        facilitiesEmptyBody,
					ActionHref:  props.CreateHref,
					ActionLabel: addFacilityLabel,
				})
			</div>
		} else {
			<div class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">{ FacilityFieldLabel(FieldFacilityName) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ FacilityFieldLabel(FieldFacilityKind) }</th>
							<th scope="col" class="pb-2 font-medium">{ FacilityFieldLabel(FieldFacilityCity) }</th>
						</tr>
					</thead>
					<tbody id={ ids.DirectoryRows(FacilitySegment) }>
						for _, f := range props.Facilities {
							@FacilityRow(f)
						}
					</tbody>
				</table>
			</div>
		}
		@components.Pagination(components.PaginationProps{
			ID:       ids.DirectoryPager(FacilitySegment),
			NextHref: props.NextHref,
		})
	</section>
}

templ FacilityRow(f FacilityView) {
	<tr id={ ids.DirectoryRow(FacilitySegment, f.ID) } class="border-b border-slate-200 last:border-b-0 dark:border-slate-800">
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ f.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-300 dark:hover:text-teal-200"
			>{ f.Name }</a>
		</th>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">{ f.Kind }</td>
		<td class="py-3 align-top text-slate-700 dark:text-slate-300">
			if f.City != "" {
				{ f.City }
			}
		</td>
	</tr>
}

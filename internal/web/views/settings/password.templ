package settings

// Password is FR-009's change: the current password as proof, and the
// replacement held to the rules FR-004 publishes.
//
// It says what will happen to the person's other sessions before they press
// anything. FR-010 ends every session issued before the change, which is a
// surprise unless it is stated — contracts/account.md and contracts/auth.md
// both require it to be.
templ Password(props PasswordProps) {
	<form
		id={ props.FormID }
		aria-label={ PasswordLandmark }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-xl flex-col gap-5"
	>
		<h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{ PasswordLandmark }</h2>
		<p class="max-w-prose text-sm text-slate-600 dark:text-slate-400">
			You stay signed in here. Every other session — another browser, another device — is ended.
		</p>
		for _, control := range props.Controls() {
			@field(control)
		}
		<ul id={ PasswordRulesID } class="-mt-3 list-disc pl-5 text-sm text-slate-600 dark:text-slate-400">
			for _, rule := range props.RuleSentences() {
				<li>{ rule }</li>
			}
		</ul>
		<div>
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ PasswordLandmark }</button>
		</div>
	</form>
}

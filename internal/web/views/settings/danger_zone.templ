package settings

import "medikube/internal/i18n"

// DangerZone is FR-013: the one irreversible operation in this phase, kept
// apart from the preferences it would otherwise sit beside.
//
// The consequence is stated BEFORE either credential is asked for, and it names
// what will be destroyed rather than asking the person to take it on trust —
// the same standard FR-028 sets for deleting one record, applied to the
// account. The labels are the kinds' own published segments, arriving as data:
// a view that spelled one would be its fourth spelling (research D-05).
templ DangerZone(props DangerZoneProps) {
	<section
		aria-label={ i18n.T(ctx, "settings.danger_zone_title") }
		class="mt-4 flex max-w-xl flex-col gap-4 rounded-lg border border-rose-300 bg-rose-50 p-4 dark:border-rose-800 dark:bg-rose-950"
	>
		<h2 class="text-lg font-semibold text-rose-900 dark:text-rose-100">{ i18n.T(ctx, "settings.danger_zone_title") }</h2>
		<div id={ HoldingsID } class="flex flex-col gap-2">
			<p class="max-w-prose text-sm font-medium text-rose-900 dark:text-rose-100">
				{ i18n.T(ctx, "settings.delete_warning") }
			</p>
			<p class="text-sm text-rose-800 dark:text-rose-200">{ i18n.T(ctx, "settings.delete_holdings_intro") }</p>
			<ul class="list-disc pl-5 text-sm text-rose-800 dark:text-rose-200">
				for _, holding := range props.Holdings {
					<li>{ holding.Text }</li>
				}
			</ul>
		</div>
		<form
			id={ props.FormID }
			aria-label={ i18n.T(ctx, "settings.delete_account_title") }
			data-on:submit__prevent={ props.OnSubmit }
			class="flex flex-col gap-5"
		>
			for _, control := range props.Controls(ctx) {
				@field(control)
			}
			<div>
				<button
					type="submit"
					class="inline-flex items-center rounded-md bg-rose-700 px-3 py-2 text-sm font-medium text-white hover:bg-rose-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700"
				>{ i18n.T(ctx, "settings.delete_account_title") }</button>
			</div>
		</form>
	</section>
}

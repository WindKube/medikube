package auth

// ForgotPassword is contracts/pages.md's P7: form[name="Reset password"], the
// one page somebody who cannot sign in can still do something on.
//
// It says nothing about the address it is given, before or after. FR-073 makes
// every recovery request answer identically whether or not an account exists,
// and a page that acknowledged a known address differently — or hinted at it in
// the words above the control — would be the same oracle wearing a friendlier
// face.
templ ForgotPassword(props ForgotPasswordProps) {
	<form
		id={ props.FormID }
		aria-label={ ResetPasswordLandmark }
		if props.Mailable {
			data-on:submit__prevent={ props.OnSubmit }
		}
		class="mx-auto flex w-full max-w-sm flex-col gap-5"
	>
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ ResetPasswordLandmark }</h1>
		if props.Mailable {
			<p class="max-w-prose text-sm text-slate-600 dark:text-slate-400">
				Give the address on your account and we will send a link to set a new password. The answer is
				the same either way, so this page never tells anybody which addresses have accounts.
			</p>
			@field(props.field(FieldEmail, "Email address", "email", "username", props.Email))
			<button
				type="submit"
				class="inline-flex items-center justify-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>Send the link</button>
		} else {
			@mailUnconfigured()
		}
		<p class="text-sm text-slate-600 dark:text-slate-400">
			<a
				href={ props.LoginHref }
				class="font-medium underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:hover:text-slate-100"
			>{ SignInLandmark }</a>
		</p>
	</form>
}

package auth

import "medikube/internal/i18n"

// ResetPassword is contracts/pages.md's P8: form[name="Choose a new password"],
// in both of the states a link can be in.
//
// The landmark is there either way, and so is the 200 (FR-074, contracts/
// pages.md): the page a dead link opens is this page, saying so, with the offer
// to ask for another — not a 404 and not an error view. The token travels in a
// hidden control because the submission is a POST and the token has to be in
// its body; the old password is never asked for, because somebody who has one
// does not need this page.
templ ResetPassword(props ResetPasswordProps) {
	<form
		id={ props.FormID }
		aria-label={ NewPasswordLandmark }
		if props.Usable {
			data-on:submit__prevent={ props.OnSubmit }
		}
		class="mx-auto flex w-full max-w-sm flex-col gap-5"
	>
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ NewPasswordLandmark }</h1>
		if props.Usable {
			<input
				id={ props.FieldID(FieldToken) }
				name={ FieldToken }
				type="hidden"
				value={ props.Token }
				data-bind={ FieldToken }
			/>
			@field(props.field(FieldPassword, i18n.T(ctx, "field.new_password"), "password", "new-password", ""))
			<ul id={ NewPasswordRulesID } class="-mt-3 list-disc pl-5 text-sm text-slate-600 dark:text-slate-400">
				for _, rule := range props.RuleSentences(ctx) {
					<li>{ rule }</li>
				}
			</ul>
			@field(props.field(FieldPasswordConfirm, i18n.T(ctx, "field.new_password_confirm"), "password", "new-password", ""))
			<button
				type="submit"
				class="inline-flex items-center justify-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ i18n.T(ctx, "auth.set_new_password") }</button>
			<p class="max-w-prose text-sm text-slate-600 dark:text-slate-400">
				{ i18n.T(ctx, "auth.new_password_ends_sessions") }
			</p>
		} else {
			@linkDead(props.deadLink(ctx))
		}
	</form>
}

package auth

import "medikube/internal/i18n"

// VerifyEmail is contracts/pages.md's P9: region[name="Email confirmation"].
//
// A region with one control in it, and NOT a confirmation performed by the GET
// itself. Opening a link must not change anything: mail clients and scanners
// follow links in messages, and a page that confirmed on sight would spend the
// token before the person had read the message. So the page asks, and the
// control posts.
//
// Its dead state is the reset page's, for the same reason and in the same
// place — inside the landmark, with what can be offered instead.
templ VerifyEmail(props VerifyEmailProps) {
	<section aria-label={ EmailConfirmationLandmark } class="mx-auto flex w-full max-w-sm flex-col gap-5">
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ EmailConfirmationLandmark }</h1>
		if props.Usable {
			<p class="max-w-prose text-sm text-slate-600 dark:text-slate-400">
				{ i18n.T(ctx, "auth.verify_email_body") }
			</p>
			<input
				id={ props.FieldID(FieldToken) }
				name={ FieldToken }
				type="hidden"
				value={ props.Token }
				data-bind={ FieldToken }
			/>
			<div>
				<button
					type="button"
					data-on:click={ props.OnConfirm }
					class="inline-flex items-center justify-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ i18n.T(ctx, "auth.confirm_my_address") }</button>
			</div>
		} else {
			@linkDead(props.deadLink(ctx))
		}
	</section>
}

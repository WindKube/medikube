package auth

import "medikube/internal/i18n"

// Login is contracts/pages.md's P1: form[name="Sign in"], which is the landmark
// the browser gate resolves with getByRole and therefore a literal that cannot
// be edited here alone.
//
// FR-005's refusal is not rendered by this component. An unknown address and a
// wrong password are one 401 with one message, and the form shows what it was
// given: field refusals beside their controls, and nothing that could differ
// between an address with an account and one without.
templ Login(props LoginProps) {
	<form
		id={ props.FormID }
		aria-label={ SignInLandmark }
		data-on:submit__prevent={ props.OnSubmit }
		class="mx-auto flex w-full max-w-sm flex-col gap-5"
	>
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ SignInLandmark }</h1>
		if props.SessionExpired {
			// FR-008. A person whose session ran out is told why, rather than
			// being dropped on an ordinary sign-in page and left to guess.
			<p
				id={ SessionExpiredID }
				role="status"
				class="rounded-md border border-amber-500 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100"
			>{ i18n.T(ctx, "auth.session_expired") }</p>
		}
		@field(props.field(FieldEmail, i18n.T(ctx, "field.email"), "email", "username", props.Email))
		@field(props.field(FieldPassword, i18n.T(ctx, "field.password"), "password", "current-password", ""))
		<button
			type="submit"
			class="inline-flex items-center justify-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
		>{ SignInLandmark }</button>
		<p class="text-sm text-slate-600 dark:text-slate-400">
			<a
				href={ props.ForgotHref }
				class="font-medium underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:hover:text-slate-100"
			>{ i18n.T(ctx, "auth.forgot_password_link") }</a>
		</p>
		<p class="text-sm text-slate-600 dark:text-slate-400">
			{ i18n.T(ctx, "auth.no_account_yet") }
			<a
				href={ props.RegisterHref }
				class="font-medium underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:hover:text-slate-100"
			>{ CreateAccountLandmark }</a>
		</p>
	</form>
}

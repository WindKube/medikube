package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

const symptomConfirmSignal = "_confirming_delete"

const (
	symptomDetailArticle    = "Symptom episode"
	symptomConfirmTitle     = "Delete this symptom episode?"
	symptomConfirmConsequence = "This is permanent. There is no recycle bin and no undo, so everything recorded here goes with it."
	symptomConfirmLabel     = "Delete permanently"
	symptomConfirmCancel    = "Keep it"
	symptomEditLabel        = "Edit"
	symptomDeleteLabel      = "Delete"
)

templ SymptomDetail(props SymptomDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Symptom, props.Symptom.ID) }
		aria-label={ symptomDetailArticle }
		data-signals={ "{" + symptomConfirmSignal + ": false, _etag: " + jsLiteral(props.Symptom.Version) + "}" }
		data-status={ props.Symptom.StatusValue }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Symptom, props.Symptom.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.Symptom.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Symptom.Links.Edit != "" {
					<a
						href={ props.Symptom.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ symptomEditLabel }</a>
				}
				<button
					type="button"
					data-on:click={ "$" + symptomConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ symptomDeleteLabel }</button>
			</div>
		</header>
		<p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
			{ itoa(props.Symptom.EpisodeCount) } episodes recorded under this name.
		</p>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Symptom.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		@components.Confirm(components.ConfirmProps{
			ID:           ids.RecordConfirm(kind.Symptom, props.Symptom.ID),
			Signal:       symptomConfirmSignal,
			Title:        symptomConfirmTitle,
			Subject:      props.Symptom.Name,
			Consequence:  symptomConfirmConsequence,
			ConfirmLabel: symptomConfirmLabel,
			ConfirmOn:    deleteSymptomExpression(props.Symptom),
			CancelLabel:  symptomConfirmCancel,
		})
	</article>
}

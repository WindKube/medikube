package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
	"medikube/internal/web/views/shared"
	"medikube/internal/web"
)

const (
	injuryEmptyTitle  = "Nothing recorded yet"
	injuryEmptyBody   = "Record the first one and it will be listed here, with everything you noted about it."
	injuryCreateLabel = "Record an injury"
	injuriesTitle     = "Injuries"
)

// InjuryList is this kind's list landmark, mirroring MedicationList.
templ InjuryList(props InjuryListProps) {
	<section
		id={ ids.RecordList(kind.Injury) }
		aria-label={ injuriesTitle }
		class="flex flex-col"
	>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.RecordListHeading(kind.Injury) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ injuriesTitle }</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ injuryCreateLabel }</a>
			}
		</div>
		<div class="[&:has(tbody_tr)_[data-empty]]:hidden [&:not(:has(tbody_tr))_[data-rows]]:hidden">
			<div data-empty class="mt-6">
				@components.EmptyState(components.EmptyStateProps{
					ID:          ids.RecordEmpty(kind.Injury),
					Title:       injuryEmptyTitle,
					Body:        injuryEmptyBody,
					ActionHref:  props.CreateHref,
					ActionLabel: injuryCreateLabel,
				})
			</div>
			<div data-rows class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">{ InjuryFieldLabel(InjuryFieldName) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ InjuryFieldLabel(InjuryFieldType) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ InjuryFieldLabel(InjuryFieldSeverity) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ InjuryFieldLabel(InjuryFieldStatus) }</th>
							<th scope="col" class="pb-2 font-medium">{ InjuryFieldLabel(InjuryFieldOccurredOn) }</th>
						</tr>
					</thead>
					<tbody id={ ids.RecordRows(kind.Injury) }>
						for _, injury := range props.Injuries {
							@InjuryRow(injury)
						}
					</tbody>
				</table>
			</div>
		</div>
		@components.Pagination(components.PaginationProps{
			ID:           ids.RecordPager(kind.Injury),
			PreviousHref: props.PreviousHref,
			NextHref:     props.NextHref,
		})
	</section>
}

// InjuryRow is the element contracts/streams.md patches by id.
templ InjuryRow(injury InjuryView) {
	<tr
		id={ ids.RecordRow(kind.Injury, injury.ID) }
		data-status={ injury.StatusValue }
		class="border-b border-slate-200 last:border-b-0 dark:border-slate-800"
	>
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ injury.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-300 dark:hover:text-teal-200"
			>{ injury.Name }</a>
		</th>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">
			if injury.Type != "" {
				<span class="sr-only">{ InjuryFieldLabel(InjuryFieldType) }</span>
				{ injury.Type }
			}
		</td>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">
			if injury.Severity != "" {
				<span class="sr-only">{ InjuryFieldLabel(InjuryFieldSeverity) }</span>
				{ injury.Severity }
			}
		</td>
		<td class="py-3 pr-4 align-top">
			<span class="sr-only">{ InjuryFieldLabel(InjuryFieldStatus) }</span>
			<span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">
				{ injury.Status }
			</span>
		</td>
		<td class="py-3 align-top tabular-nums text-slate-700 dark:text-slate-300">
			if injury.OccurredOn != "" {
				<span class="sr-only">{ InjuryFieldLabel(InjuryFieldOccurredOn) }</span>
				<time datetime={ injury.OccurredOn }>{ injury.OccurredOn }</time>
			}
		</td>
	</tr>
}

const (
	injuryConfirmSignal = "_confirming_delete"
	injuryDetailArticle = "Injury"
	injuryConfirmTitle  = "Delete this injury?"
	injuryConfirmLabel  = "Delete permanently"
	injuryConfirmCancel = "Keep it"
	injuryEditLabel     = "Edit"
	injuryDeleteLabel   = "Delete"
)

// InjuryDetail is this kind's detail landmark, mirroring MedicationDetail.
templ InjuryDetail(props InjuryDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Injury, props.Injury.ID) }
		aria-label={ injuryDetailArticle }
		data-signals={ "{" + injuryConfirmSignal + ": false, _etag: " + jsLiteral(web.ETag(props.Injury.Version)) + "}" }
		data-status={ props.Injury.StatusValue }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Injury, props.Injury.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.Injury.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Injury.Links.Edit != "" {
					<a
						href={ props.Injury.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ injuryEditLabel }</a>
				}
				<button
					type="button"
					id={ ids.RecordDelete(kind.Injury, props.Injury.ID) }
					data-on:click={ "$" + injuryConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ injuryDeleteLabel }</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Injury.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		if props.Medications.ID != "" {
			@MedicationLinksEditor(props.Medications)
		}
		@shared.DeleteConfirm(shared.DeleteConfirmProps{
			ID:             ids.RecordConfirm(kind.Injury, props.Injury.ID),
			ReturnTo: ids.RecordDelete(kind.Injury, props.Injury.ID),
			Signal:         injuryConfirmSignal,
			Title:          injuryConfirmTitle,
			Subject:        props.Injury.Name,
			ReferenceCount: 0,
			ConfirmLabel:   injuryConfirmLabel,
			ConfirmOn:      injuryDeleteExpression(props.Injury),
			CancelLabel:    injuryConfirmCancel,
		})
	</article>
}

// InjuryForm is both the create form and the edit form, mirroring
// MedicationForm.
templ InjuryForm(props InjuryFormProps) {
	<form
		id={ props.FormID }
		aria-label={ props.Label() }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-2xl flex-col gap-5"
	>
		if props.Notice != "" {
			<p role="alert" class="rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">{ props.Notice }</p>
		}
		if props.New {
			<input type="hidden" name="patient" data-bind="patient" value={ props.Injury.PatientID }/>
		}
		@injuryTextControl(props, InjuryFieldName, "text", true)
		@injurySelectControl(props, InjuryFieldType, props.Injury.TypeOptions(), true)
		@injuryTextControl(props, InjuryFieldBodyPart, "text", true)
		@injurySelectControl(props, InjuryFieldLaterality, props.Injury.LateralityOptions(), true)
		@injuryTextControl(props, InjuryFieldOccurredOn, "date", false)
		@injuryTextareaControl(props, InjuryFieldMechanism)
		@injurySelectControl(props, InjuryFieldSeverity, props.Injury.SeverityOptions(), true)
		@injurySelectControl(props, InjuryFieldStatus, props.Injury.StatusOptions(), true)
		@injuryTextareaControl(props, InjuryFieldRecoveryNotes)
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.SubmitLabel() }</button>
			if props.CancelHref != "" {
				<a
					href={ props.CancelHref }
					class="text-sm font-medium text-slate-700 underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-slate-300 dark:hover:text-slate-100"
				>{ cancelLabel }</a>
			}
		</div>
	</form>
}

templ injuryTextControl(props InjuryFormProps, field, inputType string, required bool) {
	<div class="flex flex-col">
		<label
			for={ ids.Field(props.FormID, field) }
			class="text-sm font-medium text-slate-900 dark:text-slate-100"
		>{ InjuryFieldLabel(field) }</label>
		<input
			id={ ids.Field(props.FormID, field) }
			name={ field }
			type={ inputType }
			value={ props.Injury.Value(field) }
			data-bind={ field }
			required?={ required }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		/>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ injurySelectControl(props InjuryFormProps, field string, options []Option, optional bool) {
	<div class="flex flex-col">
		<label
			for={ ids.Field(props.FormID, field) }
			class="text-sm font-medium text-slate-900 dark:text-slate-100"
		>{ InjuryFieldLabel(field) }</label>
		<select
			id={ ids.Field(props.FormID, field) }
			name={ field }
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>
			if optional {
				<option value="" selected?={ props.Injury.Value(field) == "" }>{ notRecorded }</option>
			}
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ injuryTextareaControl(props InjuryFormProps, field string) {
	<div class="flex flex-col">
		<label
			for={ ids.Field(props.FormID, field) }
			class="text-sm font-medium text-slate-900 dark:text-slate-100"
		>{ InjuryFieldLabel(field) }</label>
		<textarea
			id={ ids.Field(props.FormID, field) }
			name={ field }
			rows={ textareaRows }
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>{ props.Injury.Value(field) }</textarea>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

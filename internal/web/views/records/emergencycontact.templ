package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/ids"
	"medikube/internal/web/views/shared"
	"medikube/internal/web"
)

const contactConfirmSignal = "_confirming_delete"

templ EmergencyContactRow(contact EmergencyContactView) {
	<tr
		id={ ids.RecordRow(kind.EmergencyContact, contact.ID) }
		data-testid="contact-row"
		class="border-b border-slate-200 last:border-b-0 dark:border-slate-800"
	>
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ contact.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 dark:text-teal-300"
			>{ contact.Name }</a>
		</th>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">{ contact.Relationship }</td>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">{ contact.Phone }</td>
		<td class="py-3 pr-4 align-top">
			if contact.IsPrimary {
				<span
					data-testid="contact-primary"
					class="inline-flex items-center rounded-full bg-teal-100 px-2 py-0.5 text-xs font-semibold text-teal-900 dark:bg-teal-900 dark:text-teal-100"
				>Primary</span>
			}
		</td>
		<td class="py-3 align-top text-slate-700 dark:text-slate-300">
			if !contact.IsActive {
				<span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">Inactive</span>
			}
		</td>
	</tr>
}

templ EmergencyContactList(props EmergencyContactListProps) {
	<section id={ ids.RecordList(kind.EmergencyContact) } aria-label="Emergency contacts" class="flex flex-col">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.RecordListHeading(kind.EmergencyContact) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100"
			>Emergency contacts</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
				>Record a contact</a>
			}
		</div>
		<div class="[&:has(tbody_tr)_[data-empty]]:hidden [&:not(:has(tbody_tr))_[data-rows]]:hidden">
			<div data-empty class="mt-6">
				@shared.EmptyState(shared.NothingRecorded(ids.RecordEmpty(kind.EmergencyContact), "emergency contacts"))
			</div>
			<div data-rows class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">Name</th>
							<th scope="col" class="pb-2 pr-4 font-medium">Relationship</th>
							<th scope="col" class="pb-2 pr-4 font-medium">Phone</th>
							<th scope="col" class="pb-2 pr-4 font-medium">Primary</th>
							<th scope="col" class="pb-2 font-medium">State</th>
						</tr>
					</thead>
					<tbody id={ ids.RecordRows(kind.EmergencyContact) }>
						for _, contact := range props.Contacts {
							@EmergencyContactRow(contact)
						}
					</tbody>
				</table>
			</div>
		</div>
		@pager(ids.RecordPager(kind.EmergencyContact), props.PreviousHref, props.NextHref)
	</section>
}

templ EmergencyContactDetail(props EmergencyContactDetailProps) {
	<article
		id={ ids.RecordDetail(kind.EmergencyContact, props.Contact.ID) }
		aria-label="Emergency contact"
		data-signals={ "{" + contactConfirmSignal + ": false, _etag: " + jsLiteral(web.ETag(props.Contact.Version)) + "}" }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.EmergencyContact, props.Contact.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100"
			>{ props.Contact.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Contact.Links.Edit != "" {
					<a
						href={ props.Contact.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-100"
					>Edit</a>
				}
				<button
					type="button"
					id={ ids.RecordDelete(kind.EmergencyContact, props.Contact.ID) }
					data-on:click={ "$" + contactConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 dark:border-rose-800 dark:text-rose-300"
				>Delete</button>
			</div>
		</header>
		<div class="mt-2 flex flex-wrap gap-2">
			if props.Contact.IsPrimary {
				<span
					data-testid="contact-primary"
					class="inline-flex w-fit items-center rounded-full bg-teal-100 px-2 py-0.5 text-xs font-semibold text-teal-900 dark:bg-teal-900 dark:text-teal-100"
				>Primary</span>
			}
			if !props.Contact.IsActive {
				<span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">Inactive</span>
			}
		</div>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Contact.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		@shared.DeleteConfirm(shared.DeleteConfirmProps{
			ID:             ids.RecordConfirm(kind.EmergencyContact, props.Contact.ID),
			ReturnTo: ids.RecordDelete(kind.EmergencyContact, props.Contact.ID),
			Signal:         contactConfirmSignal,
			Title:          "Delete this contact?",
			Subject:        props.Contact.Name,
			ReferenceCount: 0,
			ConfirmLabel:   "Delete permanently",
			ConfirmOn:      contactDeleteExpression(props.Contact),
			CancelLabel:    "Keep it",
		})
	</article>
}

templ EmergencyContactForm(props EmergencyContactFormProps) {
	<form
		id={ props.FormID }
		aria-label={ props.Label() }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-2xl flex-col gap-5"
	>
		if props.Notice != "" {
			<p role="alert" class="rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">{ props.Notice }</p>
		}
		if props.New {
			<input type="hidden" name="patient" data-bind="patient" value={ props.Contact.PatientID }/>
		}
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldContactName, Label: "Name", Value: props.Contact.Value(FieldContactName), Type: "text", Required: true, Errors: props.Errors})
		@SelectControl(ControlProps{FormID: props.FormID, Field: FieldRelationship, Label: "Relationship", Value: props.Contact.Value(FieldRelationship), Required: true, Errors: props.Errors}, props.Contact.RelationshipOptions())
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldPhone, Label: "Phone", Value: props.Contact.Value(FieldPhone), Type: "tel", Required: true, Errors: props.Errors})
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldPhoneAlt, Label: "Second phone", Value: props.Contact.Value(FieldPhoneAlt), Type: "tel", Errors: props.Errors})
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldEmail, Label: "Email", Value: props.Contact.Value(FieldEmail), Type: "email", Errors: props.Errors})
		@TextareaControl(ControlProps{FormID: props.FormID, Field: FieldAddress, Label: "Address", Value: props.Contact.Value(FieldAddress), Errors: props.Errors})
		@CheckboxControl(ControlProps{FormID: props.FormID, Field: FieldIsPrimary, Label: "Primary contact", Value: props.Contact.Value(FieldIsPrimary)})
		@CheckboxControl(ControlProps{FormID: props.FormID, Field: FieldIsActive, Label: "Active", Value: props.Contact.Value(FieldIsActive)})
		@TextareaControl(ControlProps{FormID: props.FormID, Field: FieldNotes, Label: "Notes", Value: props.Contact.Value(FieldNotes), Errors: props.Errors})
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
			>{ props.SubmitLabel() }</button>
			if props.CancelHref != "" {
				<a
					href={ props.CancelHref }
					class="text-sm font-medium text-slate-700 underline underline-offset-2 hover:text-slate-900 dark:text-slate-300"
				>Cancel</a>
			}
		</div>
	</form>
}

func contactDeleteExpression(c EmergencyContactView) string {
	return "@delete(" + jsLiteral(c.Links.Record) + ", {headers: {'If-Match': $_etag}})"
}

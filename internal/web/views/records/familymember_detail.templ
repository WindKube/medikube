package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

const familyMemberConfirmSignal = "_confirming_delete"

const (
	familyMemberDetailArticle      = "Relative"
	familyMemberConfirmTitle       = "Delete this relative?"
	familyMemberConfirmConsequence = "This is permanent. There is no recycle bin and no undo, so everything recorded about them, including every condition, goes with it."
	familyMemberConfirmLabel       = "Delete permanently"
	familyMemberConfirmCancel      = "Keep it"
	familyMemberEditLabel          = "Edit"
	familyMemberDeleteLabel        = "Delete"
	familyMemberConditionsHeading  = "Conditions"
)

templ FamilyMemberDetail(props FamilyMemberDetailProps) {
	<article
		id={ ids.RecordDetail(kind.FamilyMember, props.FamilyMember.ID) }
		aria-label={ familyMemberDetailArticle }
		data-signals={ "{" + familyMemberConfirmSignal + ": false, _etag: " + jsLiteral(props.FamilyMember.Version) + "}" }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.FamilyMember, props.FamilyMember.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.FamilyMember.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.FamilyMember.Links.Edit != "" {
					<a
						href={ props.FamilyMember.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ familyMemberEditLabel }</a>
				}
				<button
					type="button"
					data-on:click={ "$" + familyMemberConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ familyMemberDeleteLabel }</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.FamilyMember.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		if len(props.FamilyMember.Conditions) > 0 {
			<section class="mt-6" aria-label={ familyMemberConditionsHeading }>
				<h2 class="text-sm font-medium text-slate-500 dark:text-slate-400">{ familyMemberConditionsHeading }</h2>
				<ul class="mt-2 flex flex-col gap-3">
					for _, condition := range props.FamilyMember.Conditions {
						<li class="rounded-md border border-slate-200 p-3 dark:border-slate-700">
							@familyConditionEntry(condition)
						</li>
					}
				</ul>
			</section>
		}
		@components.Confirm(components.ConfirmProps{
			ID:           ids.RecordConfirm(kind.FamilyMember, props.FamilyMember.ID),
			Signal:       familyMemberConfirmSignal,
			Title:        familyMemberConfirmTitle,
			Subject:      props.FamilyMember.Name,
			Consequence:  familyMemberConfirmConsequence,
			ConfirmLabel: familyMemberConfirmLabel,
			ConfirmOn:    familyMemberDeleteExpression(props.FamilyMember),
			CancelLabel:  familyMemberConfirmCancel,
		})
	</article>
}

templ familyConditionEntry(condition FamilyConditionView) {
	<p class="font-medium text-slate-900 dark:text-slate-100">{ condition.Name }</p>
	<p class="text-sm text-slate-700 dark:text-slate-300">
		if condition.DiagnosedAge != "" {
			<span>{ "diagnosed at age " + condition.DiagnosedAge }</span>
		}
		if condition.Severity != "" {
			<span>{ " · " + condition.Severity }</span>
		}
		if condition.Status != "" {
			<span>{ " · " + condition.Status }</span>
		}
	</p>
	if condition.Notes != "" {
		<p class="mt-1 whitespace-pre-wrap text-sm text-slate-700 dark:text-slate-300">{ condition.Notes }</p>
	}
}

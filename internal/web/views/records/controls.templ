package records

import (
	"medikube/internal/i18n"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

// ControlProps is one form field, generic across kinds (US1's three simple
// forms share this rather than each rolling its own textControl).
type ControlProps struct {
	FormID   string
	Field    string
	Label    string
	Value    string
	Type     string
	Required bool
	Errors   FieldErrors
}

templ TextControl(p ControlProps) {
	<div class="flex flex-col">
		<label for={ ids.Field(p.FormID, p.Field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ p.Label }</label>
		<input
			id={ ids.Field(p.FormID, p.Field) }
			name={ p.Field }
			type={ p.Type }
			value={ p.Value }
			data-bind={ p.Field }
			required?={ p.Required }
			if p.Errors.Has(p.Field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(p.FormID, p.Field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		/>
		@components.FieldError(ids.FieldError(p.FormID, p.Field), p.Errors.Messages(ctx, p.Field))
	</div>
}

templ TextareaControl(p ControlProps) {
	<div class="flex flex-col">
		<label for={ ids.Field(p.FormID, p.Field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ p.Label }</label>
		<textarea
			id={ ids.Field(p.FormID, p.Field) }
			name={ p.Field }
			rows="4"
			data-bind={ p.Field }
			if p.Errors.Has(p.Field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(p.FormID, p.Field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>{ p.Value }</textarea>
		@components.FieldError(ids.FieldError(p.FormID, p.Field), p.Errors.Messages(ctx, p.Field))
	</div>
}

templ SelectControl(p ControlProps, options []Option) {
	<div class="flex flex-col">
		<label for={ ids.Field(p.FormID, p.Field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ p.Label }</label>
		<select
			id={ ids.Field(p.FormID, p.Field) }
			name={ p.Field }
			data-bind={ p.Field }
			required?={ p.Required }
			if p.Errors.Has(p.Field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(p.FormID, p.Field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>
			if !p.Required {
				<option value="">{ i18n.T(ctx, "action.not_recorded") }</option>
			}
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select>
		@components.FieldError(ids.FieldError(p.FormID, p.Field), p.Errors.Messages(ctx, p.Field))
	</div>
}

templ pager(id, previousHref, nextHref string) {
	@components.Pagination(components.PaginationProps{ID: id, PreviousHref: previousHref, NextHref: nextHref})
}

templ CheckboxControl(p ControlProps) {
	<div class="flex items-center gap-2">
		<input
			id={ ids.Field(p.FormID, p.Field) }
			name={ p.Field }
			type="checkbox"
			checked?={ p.Value == "true" }
			data-bind={ p.Field }
			class="h-4 w-4 rounded border-slate-300 dark:border-slate-600"
		/>
		<label for={ ids.Field(p.FormID, p.Field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ p.Label }</label>
	</div>
}

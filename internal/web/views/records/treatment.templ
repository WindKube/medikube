package records

import (
	viewtags "medikube/internal/web/views/tags"
	"medikube/internal/domain/kind"
	"medikube/internal/i18n"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
	"medikube/internal/web/views/shared"
	"medikube/internal/web"
)

templ TreatmentList(props TreatmentListProps) {
	<section id={ ids.RecordList(kind.Treatment) } aria-label={ i18n.T(ctx, "page.treatmentListPage.title") } class="flex flex-col">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.RecordListHeading(kind.Treatment) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ i18n.T(ctx, "page.treatmentListPage.title") }</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ i18n.T(ctx, "action.record_treatment") }</a>
			}
		</div>
		<div class="[&:has(tbody_tr)_[data-empty]]:hidden [&:not(:has(tbody_tr))_[data-rows]]:hidden">
			<div data-empty class="mt-6">
				@components.EmptyState(components.EmptyStateProps{
					ID:          ids.RecordEmpty(kind.Treatment),
					Title:       i18n.T(ctx, "empty.nothing_recorded"),
					Body:        i18n.T(ctx, "empty.treatment_body"),
					ActionHref:  props.CreateHref,
					ActionLabel: i18n.T(ctx, "action.record_treatment"),
				})
			</div>
			<div data-rows class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">{ FieldLabel(FieldName) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ FieldLabel(FieldStatus) }</th>
							<th scope="col" class="pb-2 font-medium">{ FieldLabel(FieldStartedOn) }</th>
						</tr>
					</thead>
					<tbody id={ ids.RecordRows(kind.Treatment) }>
						for _, t := range props.Treatments {
							@TreatmentRow(t)
						}
					</tbody>
				</table>
			</div>
		</div>
		@components.Pagination(components.PaginationProps{
			ID:           ids.RecordPager(kind.Treatment),
			PreviousHref: props.PreviousHref,
			NextHref:     props.NextHref,
		})
	</section>
}

templ TreatmentRow(t TreatmentView) {
	<tr id={ ids.RecordRow(kind.Treatment, t.ID) } data-status={ t.StatusVal } class="border-b border-slate-200 last:border-b-0 dark:border-slate-800">
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ t.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-300 dark:hover:text-teal-200"
			>{ t.Name }</a>
		</th>
		<td class="py-3 pr-4 align-top">
			if t.Status != "" {
				<span class="sr-only">{ FieldLabel(FieldStatus) }</span>
				<span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">{ t.Status }</span>
			}
		</td>
		<td class="py-3 align-top tabular-nums text-slate-700 dark:text-slate-300">
			if t.StartedOn != "" {
				<span class="sr-only">{ FieldLabel(FieldStartedOn) }</span>
				<time datetime={ t.StartedOn }>{ t.StartedOn }</time>
			}
		</td>
	</tr>
}

templ TreatmentDetail(props TreatmentDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Treatment, props.Treatment.ID) }
		aria-label={ i18n.T(ctx, "a11y.treatment_article") }
		data-signals={ "{_confirming_delete: false, _etag: " + jsLiteral(web.ETag(props.Treatment.Version)) + "}" }
		data-status={ props.Treatment.StatusVal }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Treatment, props.Treatment.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.Treatment.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Treatment.Links.Edit != "" {
					<a
						href={ props.Treatment.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ i18n.T(ctx, "action.edit") }</a>
				}
				<button
					type="button"
					id={ ids.RecordDelete(kind.Treatment, props.Treatment.ID) }
					data-on:click="$_confirming_delete = true"
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ i18n.T(ctx, "action.delete") }</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Treatment.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		@shared.DeleteConfirm(shared.DeleteConfirmProps{
			ID:             ids.RecordConfirm(kind.Treatment, props.Treatment.ID),
			ReturnTo: ids.RecordDelete(kind.Treatment, props.Treatment.ID),
			Signal:         "_confirming_delete",
			Title:          i18n.T(ctx, "confirm.delete_treatment"),
			Subject:        props.Treatment.Name,
			ReferenceCount: props.ReferenceCount,
			ConfirmLabel:   i18n.T(ctx, "action.delete_permanently"),
			ConfirmOn:      treatmentDeleteExpression(props.Treatment),
			CancelLabel:    i18n.T(ctx, "confirm.keep_it"),
		})
	</article>
}

templ TreatmentForm(props TreatmentFormProps) {
	<form
		id={ props.FormID }
		aria-label={ props.Label(ctx) }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-2xl flex-col gap-5"
	>
		if props.Notice != "" {
			<p role="alert" class="rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">{ props.Notice }</p>
		}
		if props.New {
			<input type="hidden" name="patient" data-bind="patient" value={ props.Treatment.PatientID }/>
		}
		@treatmentTextControl(props, FieldName, "text", true)
		@treatmentTextControl(props, FieldType, "text", false)
		@treatmentSelectControl(props, FieldSetting, props.Treatment.SettingOptions())
		@treatmentTextareaControl(props, FieldDescription)
		@treatmentTextControl(props, FieldStartedOn, "date", false)
		@treatmentTextControl(props, FieldEndedOn, "date", false)
		@treatmentTextControl(props, FieldFrequency, "text", false)
		@treatmentTextControl(props, FieldDosage, "text", false)
		@treatmentTextareaControl(props, FieldExpectedOutcome)
		@treatmentSelectControl(props, FieldStatus, props.Treatment.StatusOptions())
		@treatmentTextareaControl(props, FieldNotes)
		@viewtags.Field(props.Tags)
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.SubmitLabel(ctx) }</button>
			if props.CancelHref != "" {
				<a
					href={ props.CancelHref }
					class="text-sm font-medium text-slate-700 underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-slate-300 dark:hover:text-slate-100"
				>{ i18n.T(ctx, "action.cancel") }</a>
			}
		</div>
	</form>
}

templ treatmentTextControl(props TreatmentFormProps, field, inputType string, required bool) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<input
			id={ ids.Field(props.FormID, field) }
			name={ field }
			type={ inputType }
			value={ props.Treatment.Value(field) }
			data-bind={ field }
			required?={ required }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		/>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ treatmentSelectControl(props TreatmentFormProps, field string, options []Option) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<select
			id={ ids.Field(props.FormID, field) }
			name={ field }
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>
			<option value="" selected?={ props.Treatment.Value(field) == "" }>{ i18n.T(ctx, "enum.unset") }</option>
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Selected }>{ i18n.T(ctx, option.Label) }</option>
			}
		</select>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ treatmentTextareaControl(props TreatmentFormProps, field string) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<textarea
			id={ ids.Field(props.FormID, field) }
			name={ field }
			rows="4"
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>{ props.Treatment.Value(field) }</textarea>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

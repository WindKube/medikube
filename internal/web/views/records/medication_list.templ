package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/i18n"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

// The empty state's words are message ids (D-06), resolved at render time.
// They are singular on purpose: the plural is this kind's path segment and
// its collection, and internal/architecture's kind literal guard reads the
// generated Go — including this file's.
const (
	emptyTitle       = "empty.nothing_recorded"
	emptyBody        = "empty.record_first_one_body"
	createLabel      = "page.medication.record"
	medicationsTitle = "nav.medications"
)

// MedicationList is contracts/pages.md P4's landmark. The empty state renders
// INSIDE it and never instead of it (FR-029): a bare centred paragraph where
// the region should be passes a presence check and fails the person, and phase
// 003 depends on this rule holding.
templ MedicationList(props MedicationListProps) {
	<section
		id={ ids.RecordList(kind.Medication) }
		aria-label={ i18n.T(ctx, medicationsTitle) }
		class="flex flex-col"
	>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.RecordListHeading(kind.Medication) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ i18n.T(ctx, medicationsTitle) }</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ i18n.T(ctx, createLabel) }</a>
			}
		</div>
		<div class="[&:has(tbody_tr)_[data-empty]]:hidden [&:not(:has(tbody_tr))_[data-rows]]:hidden">
			<div data-empty class="mt-6">
				@components.EmptyState(components.EmptyStateProps{
					ID:          ids.RecordEmpty(kind.Medication),
					Title:       i18n.T(ctx, emptyTitle),
					Body:        i18n.T(ctx, emptyBody),
					ActionHref:  props.CreateHref,
					ActionLabel: i18n.T(ctx, createLabel),
				})
			</div>
			<div data-rows class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">{ i18n.T(ctx, FieldLabel(FieldName)) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ i18n.T(ctx, FieldLabel(FieldDosage)) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ i18n.T(ctx, FieldLabel(FieldFrequency)) }</th>
							<th scope="col" class="pb-2 pr-4 font-medium">{ i18n.T(ctx, FieldLabel(FieldStatus)) }</th>
							<th scope="col" class="pb-2 font-medium">{ i18n.T(ctx, FieldLabel(FieldStartedOn)) }</th>
						</tr>
					</thead>
					<tbody id={ ids.RecordRows(kind.Medication) }>
						for _, medication := range props.Medications {
							@MedicationRow(medication)
						}
					</tbody>
				</table>
			</div>
		</div>
		@components.Pagination(components.PaginationProps{
			ID:           ids.RecordPager(kind.Medication),
			PreviousHref: props.PreviousHref,
			NextHref:     props.NextHref,
		})
	</section>
}

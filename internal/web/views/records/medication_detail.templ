package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/i18n"
	"medikube/internal/web/views/ids"
	"medikube/internal/web/views/shared"
	"medikube/internal/web"
)

// confirmSignal reveals the delete confirmation. The element is rendered with
// the page and hidden rather than created on demand, so it exists in the DOM
// whether or not it is on screen — which is what makes FR-028 assertable by the
// render gate at all.
const confirmSignal = "_confirming_delete"

// The constants below are message ids (D-06), resolved at render time.
const (
	detailArticle = "a11y.medication_detail"
	confirmTitle  = "confirm.delete_permanently"
	confirmLabel  = "action.delete"
	confirmCancel = "confirm.keep_it"
	editLabel     = "action.edit"
	deleteLabel   = "action.delete"
)

// MedicationDetail is contracts/pages.md P5's landmark: every value recorded
// for one medication, the values never recorded left out entirely rather than
// shown as empty placeholders (FR-024), and the time it last changed (FR-020).
templ MedicationDetail(props MedicationDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Medication, props.Medication.ID) }
		aria-label={ i18n.T(ctx, detailArticle) }
		data-signals={ "{" + confirmSignal + ": false, _etag: " + jsLiteral(web.ETag(props.Medication.Version)) + "}" }
		data-status={ props.Medication.StatusValue }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Medication, props.Medication.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.Medication.Name }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Medication.Links.Edit != "" {
					<a
						href={ props.Medication.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ i18n.T(ctx, editLabel) }</a>
				}
				<button
					type="button"
					id={ ids.RecordDelete(kind.Medication, props.Medication.ID) }
					data-on:click={ "$" + confirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ i18n.T(ctx, deleteLabel) }</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Medication.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ i18n.T(ctx, entry.Label) }</dt>
				@detailValue(entry)
			}
		</dl>
		if props.Links.ID != "" {
			@RemovableLinks(props.Links)
		}
		@shared.DeleteConfirm(shared.DeleteConfirmProps{
			ID:             ids.RecordConfirm(kind.Medication, props.Medication.ID),
			ReturnTo: ids.RecordDelete(kind.Medication, props.Medication.ID),
			Signal:         confirmSignal,
			Title:          i18n.T(ctx, confirmTitle),
			Subject:        props.Medication.Name,
			ReferenceCount: props.ReferenceCount,
			ConfirmLabel:   i18n.T(ctx, confirmLabel),
			ConfirmOn:      deleteExpression(props.Medication),
			CancelLabel:    i18n.T(ctx, confirmCancel),
		})
	</article>
}

templ detailValue(entry DetailEntry) {
	if entry.Multiline {
		<dd class="whitespace-pre-line break-words text-sm text-slate-900 dark:text-slate-100">{ entryValue(ctx, entry) }</dd>
	} else if entry.Datetime != "" {
		<dd class="text-sm tabular-nums text-slate-900 dark:text-slate-100">
			<time datetime={ entry.Datetime }>{ entryValue(ctx, entry) }</time>
		</dd>
	} else {
		<dd class="break-words text-sm text-slate-900 dark:text-slate-100">{ entryValue(ctx, entry) }</dd>
	}
}

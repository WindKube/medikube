package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/ids"
	"medikube/internal/web/views/shared"
)

const conditionConfirmSignal = "_confirming_delete"

templ ConditionRow(condition ConditionView) {
	<tr
		id={ ids.RecordRow(kind.Condition, condition.ID) }
		data-status={ condition.StatusValue }
		class="border-b border-slate-200 last:border-b-0 dark:border-slate-800"
	>
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ condition.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 dark:text-teal-300"
			>{ condition.Diagnosis }</a>
		</th>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">{ condition.Status }</td>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">{ condition.Severity }</td>
		<td class="py-3 align-top tabular-nums text-slate-700 dark:text-slate-300">
			if condition.OnsetOn != "" {
				<time datetime={ condition.OnsetOn }>{ condition.OnsetOn }</time>
			}
		</td>
	</tr>
}

templ ConditionList(props ConditionListProps) {
	<section id={ ids.RecordList(kind.Condition) } aria-label="Conditions" class="flex flex-col">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1
				id={ ids.RecordListHeading(kind.Condition) }
				tabindex="-1"
				class="text-xl font-semibold text-slate-900 dark:text-slate-100"
			>Conditions</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
				>Record a condition</a>
			}
		</div>
		<div class="[&:has(tbody_tr)_[data-empty]]:hidden [&:not(:has(tbody_tr))_[data-rows]]:hidden">
			<div data-empty class="mt-6">
				@shared.EmptyState(shared.NothingRecorded(ids.RecordEmpty(kind.Condition), kind.Condition.Segment()))
			</div>
			<div data-rows class="mt-4 overflow-x-auto">
				<table class="w-full border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400">
							<th scope="col" class="pb-2 pr-4 font-medium">Diagnosis</th>
							<th scope="col" class="pb-2 pr-4 font-medium">State</th>
							<th scope="col" class="pb-2 pr-4 font-medium">Severity</th>
							<th scope="col" class="pb-2 font-medium">Onset</th>
						</tr>
					</thead>
					<tbody id={ ids.RecordRows(kind.Condition) }>
						for _, condition := range props.Conditions {
							@ConditionRow(condition)
						}
					</tbody>
				</table>
			</div>
		</div>
		@pager(ids.RecordPager(kind.Condition), props.PreviousHref, props.NextHref)
	</section>
}

templ ConditionDetail(props ConditionDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Condition, props.Condition.ID) }
		aria-label="Condition"
		data-signals={ "{" + conditionConfirmSignal + ": false, _etag: " + jsLiteral(props.Condition.Version) + "}" }
		data-status={ props.Condition.StatusValue }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Condition, props.Condition.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100"
			>{ props.Condition.Diagnosis }</h1>
			<div class="flex flex-wrap gap-2">
				if props.Condition.Links.Edit != "" {
					<a
						href={ props.Condition.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-100"
					>Edit</a>
				}
				<button
					type="button"
					data-on:click={ "$" + conditionConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 dark:border-rose-800 dark:text-rose-300"
				>Delete</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Condition.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		if props.Medications.ID != "" {
			@MedicationLinksEditor(props.Medications)
		}
		@shared.DeleteConfirm(shared.DeleteConfirmProps{
			ID:             ids.RecordConfirm(kind.Condition, props.Condition.ID),
			Signal:         conditionConfirmSignal,
			Title:          "Delete this condition?",
			Subject:        props.Condition.Diagnosis,
			ReferenceCount: 0,
			ConfirmLabel:   "Delete permanently",
			ConfirmOn:      conditionDeleteExpression(props.Condition),
			CancelLabel:    "Keep it",
		})
	</article>
}

templ ConditionForm(props ConditionFormProps) {
	<form
		id={ props.FormID }
		aria-label={ props.Label() }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-2xl flex-col gap-5"
	>
		if props.Notice != "" {
			<p role="alert" class="rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">{ props.Notice }</p>
		}
		if props.New {
			<input type="hidden" name="patient" data-bind="patient" value={ props.Condition.PatientID }/>
		}
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldDiagnosis, Label: "Diagnosis", Value: props.Condition.Value(FieldDiagnosis), Type: "text", Required: true, Errors: props.Errors})
		@SelectControl(ControlProps{FormID: props.FormID, Field: FieldStatus, Label: "State", Value: props.Condition.Value(FieldStatus), Required: true, Errors: props.Errors}, props.Condition.StatusOptions())
		@SelectControl(ControlProps{FormID: props.FormID, Field: FieldSeverity, Label: "Severity", Value: props.Condition.Value(FieldSeverity), Errors: props.Errors}, props.Condition.SeverityOptions())
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldOnsetOn, Label: "Onset", Value: props.Condition.Value(FieldOnsetOn), Type: "date", Errors: props.Errors})
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldResolvedOn, Label: "Resolved", Value: props.Condition.Value(FieldResolvedOn), Type: "date", Errors: props.Errors})
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldICD10Code, Label: "ICD-10 code", Value: props.Condition.Value(FieldICD10Code), Type: "text", Errors: props.Errors})
		@TextControl(ControlProps{FormID: props.FormID, Field: FieldSNOMEDCode, Label: "SNOMED code", Value: props.Condition.Value(FieldSNOMEDCode), Type: "text", Errors: props.Errors})
		@TextareaControl(ControlProps{FormID: props.FormID, Field: FieldNotes, Label: "Notes", Value: props.Condition.Value(FieldNotes), Errors: props.Errors})
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
			>{ props.SubmitLabel() }</button>
			if props.CancelHref != "" {
				<a
					href={ props.CancelHref }
					class="text-sm font-medium text-slate-700 underline underline-offset-2 hover:text-slate-900 dark:text-slate-300"
				>Cancel</a>
			}
		</div>
	</form>
}

func conditionDeleteExpression(c ConditionView) string {
	return "@delete(" + jsLiteral(c.Links.Record) + ", {headers: {'If-Match': $_etag}})"
}

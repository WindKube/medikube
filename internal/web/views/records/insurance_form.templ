package records

import (
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

templ InsuranceForm(props InsuranceFormProps) {
	<form
		id={ props.FormID }
		aria-label={ props.Label() }
		data-on:submit__prevent={ props.OnSubmit }
		class="flex max-w-2xl flex-col gap-5"
	>
		if props.Notice != "" {
			<p role="alert" class="rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">{ props.Notice }</p>
		}
		if props.New {
			<input type="hidden" name="patient" data-bind="patient" value={ props.Insurance.PatientID }/>
		}
		@insuranceTextControl(props, FieldCompany, "text", true)
		@insuranceSelectControl(props, FieldType, props.Insurance.TypeOptions(), true)
		@insuranceTextControl(props, FieldPlanName, "text", false)
		@insuranceTextControl(props, FieldEmployerGroup, "text", false)
		@insuranceTextControl(props, FieldMemberName, "text", true)
		@insuranceTextControl(props, FieldMemberID, "text", true)
		@insuranceTextControl(props, FieldGroupNumber, "text", false)
		@insuranceTextControl(props, FieldHolderName, "text", false)
		@insuranceSelectControl(props, FieldRelationshipToHolder, props.Insurance.RelationshipOptions(), true)
		@insuranceTextControl(props, FieldEffectiveOn, "date", true)
		@insuranceTextControl(props, FieldExpiresOn, "date", false)
		@insuranceSelectControl(props, FieldStatus, props.Insurance.StatusOptions(), true)
		@insuranceCheckboxControl(props)
		@insuranceTextareaControl(props, FieldNotes)
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>{ props.SubmitLabel() }</button>
			if props.CancelHref != "" {
				<a
					href={ props.CancelHref }
					class="text-sm font-medium text-slate-700 underline underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-slate-300 dark:hover:text-slate-100"
				>{ cancelLabel }</a>
			}
		</div>
	</form>
}

templ insuranceTextControl(props InsuranceFormProps, field, inputType string, required bool) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<input
			id={ ids.Field(props.FormID, field) }
			name={ field }
			type={ inputType }
			value={ props.Insurance.Value(field) }
			data-bind={ field }
			required?={ required }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		/>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ insuranceSelectControl(props InsuranceFormProps, field string, options []Option, optional bool) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<select
			id={ ids.Field(props.FormID, field) }
			name={ field }
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>
			if optional {
				<option value="" selected?={ props.Insurance.Value(field) == "" }>{ notRecorded }</option>
			}
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ insuranceTextareaControl(props InsuranceFormProps, field string) {
	<div class="flex flex-col">
		<label for={ ids.Field(props.FormID, field) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(field) }</label>
		<textarea
			id={ ids.Field(props.FormID, field) }
			name={ field }
			rows={ textareaRows }
			data-bind={ field }
			if props.Errors.Has(field) {
				aria-invalid="true"
				aria-describedby={ ids.FieldError(props.FormID, field) }
			}
			class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
		>{ props.Insurance.Value(field) }</textarea>
		@components.FieldError(ids.FieldError(props.FormID, field), props.Errors.Messages(field))
	</div>
}

templ insuranceCheckboxControl(props InsuranceFormProps) {
	<div class="flex items-center gap-2">
		<input
			id={ ids.Field(props.FormID, FieldIsPrimary) }
			name={ FieldIsPrimary }
			type="checkbox"
			data-bind={ FieldIsPrimary }
			checked?={ props.Insurance.IsPrimary }
			class="rounded border-slate-300 dark:border-slate-600"
		/>
		<label for={ ids.Field(props.FormID, FieldIsPrimary) } class="text-sm font-medium text-slate-900 dark:text-slate-100">{ FieldLabel(FieldIsPrimary) }</label>
	</div>
}

package records

import (
	"strings"

	"medikube/internal/domain/kind"
	"medikube/internal/web/views/ids"
)

templ InsuranceRow(policy InsuranceView) {
	<tr
		id={ ids.RecordRow(kind.Insurance, policy.ID) }
		data-status={ policy.StatusValue }
		class="border-b border-slate-200 last:border-b-0 dark:border-slate-800"
	>
		<th scope="row" class="py-3 pr-4 text-left align-top font-medium">
			<a
				href={ policy.Links.Detail }
				class="text-teal-800 underline underline-offset-2 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-300 dark:hover:text-teal-200"
			>{ policy.Company }</a>
			if policy.IsPrimary {
				<span class="ml-2 inline-flex rounded-full bg-teal-100 px-2 py-0.5 text-xs font-medium text-teal-800 dark:bg-teal-950 dark:text-teal-200">Primary</span>
			}
		</th>
		<td class="py-3 pr-4 align-top text-slate-700 dark:text-slate-300">
			<span class="sr-only">{ FieldLabel(FieldType) }</span>
			{ policy.Type }
		</td>
		<td class="py-3 pr-4 align-top">
			<span class="sr-only">{ FieldLabel(FieldStatus) }</span>
			<span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800 dark:bg-slate-800 dark:text-slate-200">
				{ policy.Status }
			</span>
		</td>
		<td class="py-3 align-top tabular-nums text-slate-700 dark:text-slate-300">
			if policy.ExpiresOn != "" {
				<span class="sr-only">{ FieldLabel(FieldExpiresOn) }</span>
				<time datetime={ policy.ExpiresOn }>{ policy.ExpiresOn }</time>
			}
			if len(policy.Basis) > 0 {
				<span
					id={ ids.RecordBasis(kind.Insurance, policy.ID) }
					class="ml-2 inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-900 dark:bg-amber-950 dark:text-amber-200"
				>{ strings.Join(policy.Basis, ", ") }</span>
			}
		</td>
	</tr>
}

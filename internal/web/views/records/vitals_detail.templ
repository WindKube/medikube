package records

import (
	"medikube/internal/domain/kind"
	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
	"medikube/internal/web"
)

const vitalsConfirmSignal = "_confirming_delete"

const (
	vitalsDetailArticle       = "Measurement set"
	vitalsConfirmTitle        = "Delete this measurement set?"
	vitalsConfirmConsequence  = "This is permanent. There is no recycle bin and no undo, so everything recorded here goes with it."
	vitalsConfirmLabel        = "Delete permanently"
	vitalsConfirmCancel       = "Keep it"
	vitalsEditLabel           = "Edit"
	vitalsDeleteLabel         = "Delete"
)

templ VitalsDetail(props VitalsDetailProps) {
	<article
		id={ ids.RecordDetail(kind.Vitals, props.Vitals.ID) }
		aria-label={ vitalsDetailArticle }
		data-signals={ "{" + vitalsConfirmSignal + ": false, _etag: " + jsLiteral(web.ETag(props.Vitals.Version)) + "}" }
		class="flex flex-col"
	>
		<header class="flex flex-wrap items-start justify-between gap-3">
			<h1
				id={ ids.RecordDetailHeading(kind.Vitals, props.Vitals.ID) }
				tabindex="-1"
				class="break-words text-xl font-semibold text-slate-900 dark:text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
			>
				if props.Vitals.RecordedAt != "" {
					<time datetime={ props.Vitals.RecordedAt }>{ props.Vitals.RecordedAt }</time>
				}
			</h1>
			<div class="flex flex-wrap gap-2">
				if props.Vitals.Links.Edit != "" {
					<a
						href={ props.Vitals.Links.Edit }
						class="inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ vitalsEditLabel }</a>
				}
				<button
					type="button"
					data-on:click={ "$" + vitalsConfirmSignal + " = true" }
					class="inline-flex items-center rounded-md border border-rose-300 px-3 py-2 text-sm font-medium text-rose-800 hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-700 dark:border-rose-800 dark:text-rose-300 dark:hover:bg-rose-950"
				>{ vitalsDeleteLabel }</button>
			</div>
		</header>
		<dl class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
			for _, entry := range props.Vitals.Entries() {
				<dt class="text-sm font-medium text-slate-500 dark:text-slate-400">{ entry.Label }</dt>
				@detailValue(entry)
			}
		</dl>
		@components.Confirm(components.ConfirmProps{
			ID:           ids.RecordConfirm(kind.Vitals, props.Vitals.ID),
			Signal:       vitalsConfirmSignal,
			Title:        vitalsConfirmTitle,
			Subject:      props.Vitals.RecordedAt,
			Consequence:  vitalsConfirmConsequence,
			ConfirmLabel: vitalsConfirmLabel,
			ConfirmOn:    deleteVitalsExpression(props.Vitals),
			CancelLabel:  vitalsConfirmCancel,
		})
	</article>
}

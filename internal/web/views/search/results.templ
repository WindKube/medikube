package search

import "medikube/internal/i18n"

// Results is contracts/pages.md P: /search, landmark `search`. It is a bare
// <search> element — not `region[name="…"]` like every other page's own
// landmark — because contracts/pages.md spells this one's landmark literally
// as `search`, and the native <search> element carries that ARIA role with
// no accessible name of its own.
templ Results(props Props) {
	<search id="search-page" class="flex flex-col gap-6">
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "page.search.title") }</h1>
		<form method="get" action={ templ.URL(props.FormAction) } class="flex flex-wrap items-center gap-2">
			<input type="hidden" name="patient" value={ props.PatientID }/>
			<label for="search-q" class="sr-only">{ i18n.T(ctx, "field.search.term") }</label>
			<input
				id="search-q"
				type="search"
				name="q"
				value={ props.Query }
				placeholder={ i18n.T(ctx, "search.placeholder") }
				class="min-w-64 rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900"
			/>
			<button
				type="submit"
				class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800"
			>{ i18n.T(ctx, "page.search.title") }</button>
		</form>
		if len(props.Chips) > 0 {
			<ul aria-label={ i18n.T(ctx, "search.narrowing") } class="flex flex-wrap gap-2">
				for _, chip := range props.Chips {
					<li>
						<a
							href={ templ.URL(chip.Href) }
							class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-800 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200"
						>{ chip.Label } <span aria-hidden="true">✕</span></a>
					</li>
				}
			</ul>
		}
		if props.NoPatient {
			<div role="status" class="rounded-lg border border-dashed border-slate-300 px-6 py-12 text-center dark:border-slate-700">
				<p class="text-base font-medium text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "search.choose_person") }</p>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{ i18n.T(ctx, "search.choose_person_body") }</p>
			</div>
		} else if props.NoTerm {
			<div role="status" class="rounded-lg border border-dashed border-slate-300 px-6 py-12 text-center dark:border-slate-700">
				<p class="text-base font-medium text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "search.no_term") }</p>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{ i18n.T(ctx, "search.no_term_body") }</p>
			</div>
		} else if props.EmptyReason == "no_records" {
			<div role="status" class="rounded-lg border border-dashed border-slate-300 px-6 py-12 text-center dark:border-slate-700">
				<p class="text-base font-medium text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "search.no_records") }</p>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{ i18n.T(ctx, "search.no_records_body") }</p>
			</div>
		} else if props.EmptyReason == "no_matches" {
			<div role="status" class="rounded-lg border border-dashed border-slate-300 px-6 py-12 text-center dark:border-slate-700">
				<p class="text-base font-medium text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "search.no_matches") }</p>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{ i18n.T(ctx, "search.no_matches_body") }</p>
				if props.ClearHref != "" {
					<a
						href={ templ.URL(props.ClearHref) }
						class="mt-2 inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-900 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800"
					>{ i18n.T(ctx, "search.clear_narrowing") }</a>
				}
			</div>
		} else {
			for _, group := range props.Groups {
				<section aria-label={ group.Label } class="flex flex-col gap-2">
					<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ group.Label }</h2>
					<ul class="flex flex-col gap-1">
						for _, item := range group.Items {
							<li class="flex items-baseline justify-between gap-3 border-b border-slate-200 py-2 last:border-b-0 dark:border-slate-800">
								<a href={ templ.URL(item.Href) } class="text-teal-800 underline underline-offset-2 hover:text-teal-900 dark:text-teal-300">
									{ item.Title }
								</a>
								if item.OccurredOn != "" {
									<time datetime={ item.OccurredOn } class="shrink-0 text-sm tabular-nums text-slate-600 dark:text-slate-400">{ item.OccurredOn }</time>
								}
							</li>
						}
					</ul>
					if group.LoadMoreHref != "" {
						<a
							href={ templ.URL(group.LoadMoreHref) }
							class="self-start text-sm font-medium text-teal-800 underline underline-offset-2 hover:text-teal-900 dark:text-teal-300"
						>{ i18n.T(ctx, "search.load_more", map[string]any{"Group": group.Label}) }</a>
					}
				</section>
			}
		}
	</search>
}

package shell

// nav is contracts/pages.md's navigation landmark, present on every page
// signed in or out — what changes is its CONTENTS, never its existence,
// because phase 005's public invitation page is opened by somebody with no
// session who needs exactly the two links a signed-out nav holds.
templ nav(links []NavLink) {
	<nav role="navigation" aria-label="Primary">
		<ul class="flex flex-wrap gap-4">
			for _, link := range links {
				<li>
					if link.Current {
						<a href={ templ.SafeURL(link.Href) } aria-current="page">{ link.Label }</a>
					} else {
						<a href={ templ.SafeURL(link.Href) }>{ link.Label }</a>
					}
				</li>
			}
		</ul>
	</nav>
}

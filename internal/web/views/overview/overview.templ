package overview

import (
	"context"

	"medikube/internal/i18n"
)

// Overview is contracts/pages.md P3's landmark: the application root, kept
// plain on purpose — a count and two links, and nothing FR-050 did not ask
// for.
templ Overview(props Props) {
	<section aria-label={ i18n.T(ctx, "nav.overview") } class="flex flex-col gap-4">
		<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{ i18n.T(ctx, "nav.overview") }</h1>
		<p class="text-sm text-slate-700 dark:text-slate-300">
			{ medicationSummary(ctx, props.MedicationCount, props.MedicationsLabel) }
		</p>
		<ul class="flex flex-col gap-2">
			<li>
				<a
					href={ templ.SafeURL(props.MedicationsHref) }
					class="text-sm font-medium text-teal-700 underline underline-offset-2 hover:text-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-400"
				>{ i18n.T(ctx, "overview.go_to_medications", map[string]any{"Label": props.MedicationsLabel}) }</a>
			</li>
			<li>
				<a
					href={ templ.SafeURL(props.SettingsHref) }
					class="text-sm font-medium text-teal-700 underline underline-offset-2 hover:text-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 dark:text-teal-400"
				>{ i18n.T(ctx, "overview.go_to_settings") }</a>
			</li>
		</ul>
	</section>
}

// medicationSummary wraps kind.medication's own plural form (D-06) rather
// than branching on count itself, so Polish's few/many/other forms agree
// with the number the way they would nowhere else in this sentence
// (spec US1-5, FR-008).
func medicationSummary(ctx context.Context, count int, label string) string {
	if count == 0 {
		return i18n.T(ctx, "overview.medication_summary_zero", map[string]any{"Label": label})
	}

	return i18n.T(ctx, "overview.medication_summary", map[string]any{"Kind": i18n.N(ctx, "kind.medication", count)})
}

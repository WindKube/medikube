package patients

import (
	"strconv"

	"medikube/internal/web/views/components"
	"medikube/internal/web/views/ids"
)

const (
	patientsRegion = "Patients"
	emptyTitle     = "Nobody recorded yet"
	emptyBody      = "Add the first person and they will be listed here."
	createLabel    = "Add a person"
	selfMarker     = "You"
)

// PatientList is contracts/pages.md P1's landmark. The empty state renders
// INSIDE it and never instead of it (FR-029) — every account has at least a
// self-record, so this state is unreachable in production, but the shape is
// the same rule as every other list in the application.
templ PatientList(props PatientListProps) {
	<section
		id={ ids.PatientList() }
		aria-label={ patientsRegion }
		class="flex flex-col"
	>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">
				{ patientsRegion }
				<span class="text-sm font-normal text-slate-500 dark:text-slate-400">
					({ strconv.Itoa(props.Total) })
				</span>
			</h1>
			if props.CreateHref != "" {
				<a
					href={ props.CreateHref }
					class="inline-flex items-center rounded-md bg-teal-700 px-3 py-2 text-sm font-medium text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
				>{ createLabel }</a>
			}
		</div>
		if len(props.Patients) == 0 {
			<div class="mt-6">
				@components.EmptyState(components.EmptyStateProps{
					ID:          ids.PatientEmpty(),
					Title:       emptyTitle,
					Body:        emptyBody,
					ActionHref:  props.CreateHref,
					ActionLabel: createLabel,
				})
			</div>
		} else {
			<ul class="mt-4 flex flex-col divide-y divide-slate-200 dark:divide-slate-800">
				for _, patient := range props.Patients {
					@PatientRow(patient)
				}
			</ul>
		}
		@components.Pagination(components.PaginationProps{
			ID:           ids.PatientList() + "-pager",
			PreviousHref: props.PreviousHref,
			NextHref:     props.NextHref,
		})
	</section>
}
